{
    "name": "express-server",
    "version": "0.0.1",
    "description": "",
    "main": "./src/app.ts",
    "scripts": {
        "build": "tsc && tsc-alias",
        "dev": "nodemon --exec \"ts-node -r tsconfig-paths/register src/app.ts\"",
        "preview": "node dist/app.js",
        "start": "pnpm build && pnpm preview",
        "lint": "pnpm --silent eslint && pnpm --silent stylelint",
        "lint:fix": "pnpm --silent eslint:fix && pnpm --silent stylelint:fix",
        "lint:strict": "pnpm --silent eslint:strict && pnpm --silent stylelint:strict"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.1.0",
        "js-yaml": "^4.1.1"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.2",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.15.27",
        "nodemon": "^3.1.10",
        "prettier": "^3.5.3",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    }
}