{
    "name": "express-server",
    "version": "0.0.1",
    "description": "",
    "main": "./src/app.ts",
    "scripts": {
        "clean": "rimraf dist",
        "build": "npm run clean && tsc && tsc-alias && copyfiles -u 1 \"src/**/*.+(yml|yaml|json)\" dist",
        "dev": "nodemon --exec \"ts-node -r tsconfig-paths/register src/app.ts\"",
        "preview": "node dist/app.js",
        "start": "ts-node -r tsconfig-paths/register src/app.ts",
        "lint": "pnpm --silent eslint && pnpm --silent stylelint",
        "lint:fix": "pnpm --silent eslint:fix && pnpm --silent stylelint:fix",
        "lint:strict": "pnpm --silent eslint:strict && pnpm --silent stylelint:strict",
        "typeorm": "typeorm-ts-node-commonjs"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "cors": "^2.8.6",
        "express": "^5.1.0",
        "js-yaml": "^4.1.1",
        "jsonschema": "^1.5.0",
        "pg": "^8.21.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "1.0.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.2",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.15.27",
        "copyfiles": "^2.4.1",
        "nodemon": "^3.1.10",
        "prettier": "^3.5.3",
        "rimraf": "^6.1.3",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    }
}
